# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nutritious_diet
DB_POOL_SIZE=5

# Cloud LLM (used later by chat/RAG generation)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Local MiniCPM recognition service
FINETUNE_API_URL=http://127.0.0.1:8002/recognize
FINETUNE_TIMEOUT_SECONDS=300
MINICPM_BASE_MODEL_PATH=D:\models\MiniCPM-V-4.6
MINICPM_FINETUNED_API_URL=http://127.0.0.1:8000/v1/chat/completions
MINICPM_SERVICE_HOST=127.0.0.1
MINICPM_SERVICE_PORT=8002

# Backend
APP_HOST=127.0.0.1
APP_PORT=8001

# New LangChain RAG (blank index path uses backend/data/vector_db/bge_m3_v1)
RAG_EMBEDDING_MODEL_PATH=D:\models\bge-m3
RAG_INDEX_PATH=
# Threshold is intentionally unset until calibrated on evaluation questions.
RAG_TOP_K=3
RAG_MAX_DISTANCE=

# Legacy RAG builder (will be replaced)
RAG_KNOWLEDGE_SOURCE=
RAG_VECTOR_DB_PATH=
OLLAMA_BASE_URL=http://127.0.0.1:11434

